{
  "phase": 5,
  "train_year": 2019,
  "validation_year": 2020,
  "test_year": 2021,
  "test_scoring": false,
  "seed": 42,
  "thread_limit": 1,
  "models": ["random_forest_balanced", "lightgbm", "lightgbm_balanced"],
  "primary_selection": "mean_macro_f1_on_2019_quarterly_cv",
  "tie_break": "lexicographic_model_name",
  "sampling": "none",
  "decision_rule": "multiclass_argmax",
  "hyperparameter_search": false,
  "random_forest": {
    "n_estimators": 120,
    "max_depth": 18,
    "max_features": "sqrt",
    "min_samples_leaf": 15,
    "class_weight": "balanced_subsample",
    "bootstrap": true,
    "max_samples": 0.7
  },
  "lightgbm": {
    "n_estimators": 300,
    "learning_rate": 0.05,
    "num_leaves": 31,
    "max_depth": -1,
    "min_child_samples": 50,
    "subsample": 0.8,
    "subsample_freq": 1,
    "colsample_bytree": 0.8,
    "reg_lambda": 1.0,
    "verbosity": -1,
    "deterministic": true,
    "force_col_wise": true
  }
}
