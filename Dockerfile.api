FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-serving.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-serving.txt

COPY api/ ./api/
COPY src/ ./src/
COPY config/stats19_data_guide_2025.xlsx ./config/stats19_data_guide_2025.xlsx
COPY config/explanation_reference.json ./config/explanation_reference.json
COPY models/release_v1/selected.joblib ./models/release_v1/selected.joblib

ENV ACCIDENTIQ_MODEL_PATH=/app/models/release_v1/selected.joblib \
    ACCIDENTIQ_REFERENCE_PATH=/app/config/explanation_reference.json \
    ACCIDENTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
